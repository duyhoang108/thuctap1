{
  "info": {
    "_postman_id": "4c3f5e1b-8c3d-4c0a-9c2a-task-workflow",
    "name": "Task Assignment Manual Tests",
    "description": "Manual tests for MANAGER and EMPLOYEE task assignment, authorization, status, and progress.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "managerToken",
      "value": ""
    },
    {
      "key": "employeeToken",
      "value": ""
    },
    {
      "key": "taskId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Login Manager - copy access_token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"boss@gmail.com\",\n  \"password\": \"Password@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        },
        "description": "Send the request and copy response.access_token into the managerToken collection variable."
      }
    },
    {
      "name": "2. Login Employee - copy access_token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"staff@gmail.com\",\n  \"password\": \"Password@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        },
        "description": "Send the request and copy response.access_token into the employeeToken collection variable."
      }
    },
    {
      "name": "3. Manager creates task 1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Hoan thanh bao cao thuc tap\",\n  \"description\": \"Viet va gui bao cao truoc thu Sau\",\n  \"assigneeId\": 3\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"]
        },
        "description": "Expected: 201. Copy response.id into the taskId collection variable."
      }
    },
    {
      "name": "4. Manager creates task 2 - verify multiple tasks",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Kiem thu API\",\n  \"description\": \"Kiem tra dang ky va dang nhap\",\n  \"assigneeId\": 3\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"]
        },
        "description": "Expected: 201. A manager can create more than one task."
      }
    },
    {
      "name": "5. Employee lists assigned tasks",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{employeeToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"]
        },
        "description": "Expected: 200 and both assigned tasks are returned."
      }
    },
    {
      "name": "6. Employee updates progress to 50 percent",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{employeeToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"progress\": 50,\n  \"status\": \"IN_PROGRESS\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskId}}"]
        },
        "description": "Expected: 200. The task is IN_PROGRESS at 50 percent."
      }
    },
    {
      "name": "7. Manager updates employee task",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"progress\": 75,\n  \"status\": \"IN_PROGRESS\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskId}}"]
        },
        "description": "Expected: 200. The manager who created the task can update it."
      }
    },
    {
      "name": "8. Employee completes task",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{employeeToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"progress\": 100,\n  \"status\": \"DONE\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskId}}"]
        },
        "description": "Expected: 200. The task is DONE at 100 percent."
      }
    },
    {
      "name": "9. Employee cannot create task",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{employeeToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Task khong duoc phep\",\n  \"assigneeId\": 3\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"]
        },
        "description": "Expected: 403 Forbidden."
      }
    },
    {
      "name": "10. Reject invalid progress",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{employeeToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"progress\": 120,\n  \"status\": \"IN_PROGRESS\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskId}}"]
        },
        "description": "Expected: 400 Bad Request because progress must be between 0 and 100."
      }
    },
    {
      "name": "11. Reject invalid status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{employeeToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"progress\": 20,\n  \"status\": \"PENDING\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskId}}"]
        },
        "description": "Expected: 400 Bad Request because status must be TODO, IN_PROGRESS, or DONE."
      }
    },
    {
      "name": "12. Manager deletes task",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskId}}"]
        },
        "description": "Expected: 200. The manager who created the task can delete it."
      }
    }
  ]
}
