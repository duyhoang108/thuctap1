{
  "info": {
    "_postman_id": "4c3f5e1b-8c3d-4c0a-9c2a-task-evidence",
    "name": "Task Evidence Upload Tests",
    "description": "Short Postman flow for uploading and downloading task evidence.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "managerToken", "value": "" },
    { "key": "employeeToken", "value": "" },
    { "key": "taskId", "value": "" },
    { "key": "evidenceId", "value": "" },
    { "key": "evidenceFile", "value": "C:\\Temp\\evidence.txt" }
  ],
  "item": [
    {
      "name": "1. Login Manager",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"boss@gmail.com\",\n  \"password\": \"Password@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set('managerToken', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Login Employee",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"staff@gmail.com\",\n  \"password\": \"Password@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set('employeeToken', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Create Task",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Task test upload minh chung\",\n  \"description\": \"Task dung de kiem tra upload\",\n  \"assigneeId\": 3\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set('taskId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Upload Evidence",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{employeeToken}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "progress", "value": "50", "type": "text" },
            { "key": "status", "value": "IN_PROGRESS", "type": "text" },
            {
              "key": "evidence",
              "type": "file",
              "src": "{{evidenceFile}}"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskId}}"]
        },
        "description": "Chon file trong form-data hoac dat duong dan tai bien evidenceFile."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const evidence = pm.response.json().evidences[0];",
              "pm.collectionVariables.set('evidenceId', evidence.id);",
              "pm.test('Evidence duoc luu o tien do 50%', () => pm.expect(evidence.progress).to.eql(50));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. View Evidence Metadata",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskId}}"]
        },
        "description": "Kiem tra originalName, submittedAt, progress va submittedBy."
      }
    },
    {
      "name": "6. Download Evidence",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}/evidences/{{evidenceId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskId}}", "evidences", "{{evidenceId}}"]
        },
        "description": "Trong Postman chon Send and Download de luu file."
      }
    }
  ]
}
