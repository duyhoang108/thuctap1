              "pm.test('Update = 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Không trả password', function () {",
              "    const user = pm.response.json().user;",
              "    pm.expect(user.password).to.be.undefined;",
              "    pm.expect(user.name).to.eql('Postman Updated User');",
              "    pm.expect(user.profile).to.include.all.keys('id', 'phone', 'date_of_birth', 'gender');",
              "    pm.expect(user.profile.phone).to.eql('+84909999999');",
              "    pm.expect(user.profile.date_of_birth).to.eql('2000-01-30');",
              "    pm.expect(user.profile.gender).to.eql('female');",
              "});"
            ]
          }
        }
