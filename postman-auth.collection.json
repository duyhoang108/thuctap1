{
  "info": {
    "_postman_id": "f6d8c9df-9df8-4ac2-8d2d-auth-api",
    "name": "ThucTap Auth API - Full Test",
    "description": "Collection test health, register, login, JWT profile, refresh, users CRUD, pagination and validation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "testName",
      "value": "Postman Test User"
    },
    {
      "key": "testEmail",
      "value": ""
    },
    {
      "key": "testPassword",
      "value": "Password@123"
    },
    {
      "key": "newPassword",
      "value": "NewPassword@123"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/health",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Health = 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Register - tạo user mới",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{testName}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"profile\": {\n    \"phone\": \"+84901234567\",\n    \"date_of_birth\": \"1998-05-20\",\n    \"gender\": \"male\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set('testEmail', 'postman.' + Date.now() + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Register = 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('userId', json.user.id);",
              "pm.test('User có đủ thuộc tính công khai', function () {",
              "    pm.expect(json.user).to.include.all.keys('id', 'name', 'email', 'profile');",
              "    pm.expect(json.user.profile).to.include.all.keys('id', 'phone', 'date_of_birth', 'gender');",
              "    pm.expect(json.user.profile.phone).to.eql('+84901234567');",
              "    pm.expect(json.user.profile.date_of_birth).to.eql('1998-05-20');",
              "    pm.expect(json.user.profile.gender).to.eql('male');",
              "});",
              "pm.test('Không trả password', function () {",
              "    pm.expect(json.user.password).to.be.undefined;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Register - email trùng (phải lỗi 409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Duplicate User\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Email trùng = 409', function () {",
              "    pm.response.to.have.status(409);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Login - lưu token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login = 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('accessToken', json.access_token);",
              "pm.collectionVariables.set('refreshToken', json.refresh_token);",
              "pm.test('Login trả user và profile đầy đủ', function () {",
              "    pm.expect(json.user).to.include.all.keys('id', 'name', 'email', 'profile');",
              "    pm.expect(json.user.profile).to.include.all.keys('id', 'phone', 'date_of_birth', 'gender');",
              "    pm.expect(json.user.password).to.be.undefined;",
              "});",
              "pm.test('Có access token', function () {",
              "    pm.expect(json.access_token).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Profile - JWT hợp lệ",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/profile",
          "host": ["{{baseUrl}}"],
          "path": ["profile"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Profile = 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Profile - không có token (phải lỗi 401)",
