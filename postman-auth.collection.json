    {
      "name": "7. Refresh token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/refresh",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "refresh"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Refresh = 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('accessToken', json.access_token);",
              "pm.collectionVariables.set('refreshToken', json.refresh_token);",
              "pm.test('Có access token mới', function () {",
              "    pm.expect(json.access_token).to.be.a('string').and.not.empty;",
              "});",
              "pm.test('Có refresh token mới', function () {",
              "    pm.expect(json.refresh_token).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Users - danh sách mặc định",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/users",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "users"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Danh sách = 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.expect(json).to.have.property('data');",
              "pm.expect(json).to.have.property('meta');",
              "json.data.forEach(function (user) {",
              "    pm.expect(user).to.include.all.keys('id', 'name', 'email', 'profile');",
              "    pm.expect(user.password).to.be.undefined;",
              "    if (user.profile) {",
              "        pm.expect(user.profile).to.include.all.keys('id', 'phone', 'date_of_birth', 'gender');",
              "    }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Users - phân trang page 1 limit 2",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/users?page=1&limit=2",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "users"],
          "query": [
            {"key": "page", "value": "1"},
            {"key": "limit", "value": "2"}
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Phân trang = 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const meta = pm.response.json().meta;",
              "pm.expect(meta.page).to.eql(1);",
              "pm.expect(meta.limit).to.eql(2);",
              "pm.expect(pm.response.json().data.length).to.be.at.most(2);"
            ]
          }
        }
      ]
    },
