    {
      "name": "11. User - lấy theo ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/users/{{userId}}",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "users", "{{userId}}"]
